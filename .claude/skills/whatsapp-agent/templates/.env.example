# انسخ هذا الملف إلى .env وعبّي القيم — ممنوع رفع .env إلى git
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

WHATSAPP_TOKEN=            # Permanent token من System User
WHATSAPP_PHONE_NUMBER_ID=  # من WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=     # أي نص سري تختاره، نفسه يتكتب في إعدادات الـ webhook
WHATSAPP_APP_SECRET=       # App Settings → Basic → App Secret
GRAPH_API_VERSION=v23.0

# أرقام الإدارة (بدون +، مفصولة بفاصلة) — تستقبل تنبيهات التحويل وتقدر ترسل /bot on <رقم>
ADMIN_NUMBERS=
HANDOFF_HOURS=12           # البوت يسكت عن العميل المحوَّل هالمدة إذا ما رجّعه أحد
HISTORY_TURNS=20           # كم رسالة سابقة يتذكرها لكل عميل
DB_PATH=agent.db
