# انسخ هالملف إلى .env (أو حط القيم في إعدادات الاستضافة) — ممنوع رفع .env لـ GitHub
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5     # أرخص: claude-sonnet-5-5 أو claude-haiku-5-5
CLAUDE_EFFORT=medium

WHATSAPP_TOKEN=                  # Permanent token من System User
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=           # أي كلمة سر تختارها، نفسها في إعدادات الـ webhook
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

ADMIN_NUMBER=                    # رقم ميثم بدون + (مثل 965xxxxxxxx) — يستلم التنبيهات والأوامر
WORKER_NUMBERS=                  # رقم العامل:رقم السيارة، مثل 965aaaaaaaa:1,965bbbbbbbb:2
PAYMENT_LINK=                    # رابط الدفع الثابت (فاضي = كي نت مع الشباب فقط)
ELEVENLABS_API_KEY=              # لتحويل الفويس لنص (فاضي = يطلب من العميل يكتب)

HANDOFF_HOURS=12
HISTORY_TURNS=30
DB_PATH=bigbubbles.db
